<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF9FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Programa Escolar"
            android:textAlignment="center"
            android:textColor="#4B4B55"
            android:textSize="30sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etId"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:hint="ID de actividad (actualizar/eliminar)"
            android:inputType="number"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="#333333"
            android:textColorHint="#9B9B9B"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etDia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Día"
            android:inputType="textCapSentences"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="#333333"
            android:textColorHint="#9B9B9B"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etHora"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Hora"
            android:inputType="text"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="#333333"
            android:textColorHint="#9B9B9B"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etActividad"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Actividad"
            android:inputType="textCapSentences"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="#333333"
            android:textColorHint="#9B9B9B"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Registrar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="#6C4CCF"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConsultar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Consultar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="#6C4CCF"
                app:cornerRadius="28dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActualizar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Actualizar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="#6C4CCF"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Eliminar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="#6C4CCF"
                app:cornerRadius="28dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Aquí aparecerán las actividades..."
            android:textColor="#666666"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
